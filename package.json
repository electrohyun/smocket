{
  "name": "smocket",
  "version": "0.5.0",
  "description": "Socket.IO mock for frontend development and testing, with full room, namespace, and broadcast support. Pre-1.0: the API may change before 1.0.0.",
  "type": "module",
  "license": "MIT",
  "author": "electrohyun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrohyun/smocket.git"
  },
  "bugs": "https://github.com/electrohyun/smocket/issues",
  "homepage": "https://github.com/electrohyun/smocket#readme",
  "keywords": [
    "socket.io",
    "socketio",
    "websocket",
    "mock",
    "mocking",
    "testing",
    "test-utils",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:real": "vitest run --project=real",
    "test:mock": "vitest run --project=mock",
    "test:browser": "tsup && pnpm --filter smocket-client build && vitest run --config vitest.browser.config.ts",
    "test:shared-worker": "tsup && node experiments/shared-worker-lobby/experiment.mjs",
    "test:shared-worker:lifecycle": "node scripts/shared-worker-lifecycle.mjs",
    "test:shared-worker:parity": "node scripts/shared-worker-sidecar-parity.mjs",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "coverage": "vitest run --project=mock --coverage",
    "typecheck": "tsup && tsc --noEmit && tsc -p tsconfig.published-types.json && pnpm --filter smocket-client typecheck && pnpm --filter smocket-client build && pnpm --filter drawing-game-example typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "publint",
    "attw": "attw --pack .",
    "assert:no-imports": "node scripts/assert-no-imports.js",
    "assert:packed-package": "node scripts/check-packed-package.mjs",
    "release:candidate": "node scripts/release-candidate.mjs create --output .release-candidate",
    "check:release-candidate": "node scripts/check-release-candidate.mjs --manifest .release-candidate/release-candidate.json",
    "verify:published-release": "node scripts/verify-published-release.mjs",
    "check:package": "pnpm build && pnpm assert:no-imports && pnpm assert:packed-package && pnpm publint && pnpm attw",
    "check:client-package": "pnpm --filter smocket-client build && pnpm --filter smocket-client test && node scripts/check-client-package.mjs && pnpm --filter smocket-client publint && pnpm --filter smocket-client attw",
    "example:chat-room": "pnpm build && pnpm --filter smocket-client build && pnpm --filter chat-room-example test && pnpm --filter chat-room-example start",
    "example:drawing-game": "pnpm example:drawing-game:test",
    "example:drawing-game:prepare": "pnpm build && pnpm --filter smocket-client build",
    "example:drawing-game:real": "pnpm example:drawing-game:prepare && pnpm --filter drawing-game-example real",
    "example:drawing-game:smocket": "pnpm example:drawing-game:prepare && pnpm --filter drawing-game-example smocket",
    "example:drawing-game:test": "pnpm example:drawing-game:prepare && pnpm --filter drawing-game-example test",
    "example:drawing-game:observe": "pnpm example:drawing-game:prepare && pnpm --filter drawing-game-example observe",
    "example:drawing-game:snippets": "node scripts/drawing-game-snippets.mjs --write",
    "example:drawing-game:snippets:check": "node scripts/drawing-game-snippets.mjs --check",
    "consumer:chat-room:published": "node scripts/run-chat-room-consumer.mjs published",
    "consumer:chat-room:candidate": "node scripts/run-chat-room-consumer.mjs candidate",
    "consumer:client:candidate": "node scripts/run-client-package-consumer.mjs",
    "case-study:chat-room": "node scripts/run-chat-room-case-study.mjs",
    "case-study:chat-room:record": "node scripts/run-chat-room-case-study.mjs --write",
    "case-study:chat-room:check": "node scripts/run-chat-room-case-study.mjs --check",
    "case-study:drawing-game": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs",
    "case-study:drawing-game:prepare": "pnpm example:drawing-game:prepare && pnpm --filter drawing-game-example build",
    "case-study:drawing-game:record": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --write",
    "case-study:drawing-game:check": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --check",
    "case-study:drawing-game:test": "node --test case-studies/drawing-game/case-study.test.mjs",
    "case-study:drawing-game:snippets": "node scripts/drawing-game-case-study-snippets.mjs --write",
    "case-study:drawing-game:snippets:check": "node scripts/drawing-game-case-study-snippets.mjs --check",
    "case-study:drawing-game:real": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --target real",
    "case-study:drawing-game:smocket": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --target smocket",
    "case-study:drawing-game:mock-socket": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --target mock-socket",
    "case-study:drawing-game:msw-binding": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --target msw-binding",
    "case-study:drawing-game:socket-io-mock": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-case-study.mjs --target socket.io-mock",
    "case-study:drawing-game:maintenance": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-maintenance.mjs",
    "case-study:drawing-game:maintenance:record": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-maintenance.mjs --write",
    "case-study:drawing-game:maintenance:check": "pnpm case-study:drawing-game:prepare && node scripts/run-drawing-game-maintenance.mjs --check",
    "case-study:drawing-game:maintenance:handwritten": "pnpm case-study:drawing-game:prepare && node --import ./case-studies/drawing-game/fixtures/handwritten/handwritten-substitution.mjs ./case-studies/drawing-game/fixtures/handwritten/probe.mjs",
    "case-study:drawing-game:maintenance:snippets": "node scripts/drawing-game-maintenance-snippets.mjs --write",
    "case-study:drawing-game:maintenance:snippets:check": "node scripts/drawing-game-maintenance-snippets.mjs --check",
    "case-study:drawing-game:publication:record": "node scripts/drawing-game-publication.mjs --write",
    "case-study:drawing-game:publication:check": "node scripts/drawing-game-publication.mjs --check",
    "case-study:drawing-game:publication:validate": "node scripts/drawing-game-publication.mjs --validate",
    "conformance": "node scripts/conformance-report.mjs",
    "check:conformance": "node scripts/conformance-report.mjs --check",
    "public-surface": "node scripts/check-public-surface.mjs --write",
    "check:public-surface": "node scripts/check-public-surface.mjs --check && node --test scripts/check-public-surface.test.mjs",
    "check:published-types": "node scripts/check-published-types.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "publint": "^0.3.23",
    "socket.io": "^4.8.3",
    "socket.io-4.7": "npm:socket.io@4.7.5",
    "socket.io-4.8": "npm:socket.io@4.8.3",
    "socket.io-client": "^4.8.3",
    "socket.io-client-4.7": "npm:socket.io-client@4.7.5",
    "socket.io-client-4.8": "npm:socket.io-client@4.8.3",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
