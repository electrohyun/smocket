{
  "name": "smocket",
  "version": "0.3.0",
  "description": "Socket.IO mock for frontend development and testing, with full room, namespace, and broadcast support. Pre-1.0: the API may change before 1.0.0.",
  "type": "module",
  "license": "MIT",
  "author": "electrohyun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrohyun/smocket.git"
  },
  "bugs": "https://github.com/electrohyun/smocket/issues",
  "homepage": "https://github.com/electrohyun/smocket#readme",
  "keywords": [
    "socket.io",
    "socketio",
    "websocket",
    "mock",
    "mocking",
    "testing",
    "test-utils",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:real": "vitest run",
    "test:mock": "SMOCKET_TARGET=mock vitest run",
    "coverage": "SMOCKET_TARGET=mock vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "publint",
    "attw": "attw \"$(pnpm pack 2>/dev/null | tail -1)\"",
    "check:package": "pnpm build && pnpm publint && pnpm attw"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "publint": "^0.3.23",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
